<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rakesh Kumar | Digital Marketing Strategist &amp; Customer Acquisition System Architect</title>
<meta name="description" content="Rakesh Kumar helps businesses attract the right audience, generate quality leads, improve conversions, and achieve sustainable growth through AI-powered digital marketing strategies.">
<meta name="keywords" content="digital marketing strategist, Meta Ads, Google Ads, lead generation, AI marketing, WhatsApp marketing, Chandigarh digital marketer">
<meta name="author" content="Rakesh Kumar">
<meta property="og:title" content="Rakesh Kumar | Digital Marketing Strategist">
<meta property="og:description" content="I don't just market businesses. I build smart digital marketing systems that turn attention into customers.">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>
  :root{
    --navy:#0B2545;
    --navy-2:#123C6B;
    --blue:#2E8BFF;
    --blue-soft:#EAF4FF;
    --blue-mist:#F5F9FF;
    --white:#FFFFFF;
    --ink:#16233A;
    --ink-mute:#5B6B84;
    --line:rgba(11,37,69,0.09);
    --gold:#F2A93B;
    --radius:20px;
    --maxw:1180px;
    --shadow:0 20px 44px rgba(11,37,69,0.09);
    --shadow-lg:0 30px 60px rgba(11,37,69,0.16);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Inter',sans-serif; color:var(--ink); background:var(--white);
    -webkit-font-smoothing:antialiased; overflow-x:hidden;
  }
  h1,h2,h3,h4,.display-name,.logo{font-family:'Poppins',sans-serif;}
  a{color:inherit; text-decoration:none;}
  ul{list-style:none;}
  img{max-width:100%; display:block;}
  .wrap{max-width:var(--maxw); margin:0 auto; padding:0 24px;}
  section{position:relative; padding:96px 0;}
  @media (max-width:700px){ section{padding:64px 0;} }
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px; font-size:13px; font-weight:600;
    letter-spacing:.06em; text-transform:uppercase; color:var(--blue);
    background:var(--blue-soft); padding:8px 16px; border-radius:999px; margin-bottom:18px;
  }
  .section-head{max-width:680px; margin:0 auto 52px; text-align:center;}
  .section-head h2{font-size:clamp(26px,3.6vw,40px); font-weight:700; line-height:1.2; letter-spacing:-0.01em; margin-bottom:14px;}
  .section-head h2 .accent{color:var(--blue);}
  .section-head p{font-size:16px; color:var(--ink-mute); line-height:1.65;}
  .btn{
    display:inline-flex; align-items:center; gap:10px; font-weight:600; font-size:15px;
    padding:15px 26px; border-radius:12px; cursor:pointer; border:none; transition:transform .18s ease, box-shadow .18s ease, background .18s ease;
  }
  .btn-primary{background:var(--navy); color:#fff; box-shadow:0 14px 28px rgba(11,37,69,0.22);}
  .btn-primary:hover{background:var(--blue); transform:translateY(-2px); box-shadow:0 16px 32px rgba(46,139,255,0.3);}
  .btn-secondary{background:var(--white); color:var(--navy); border:1.5px solid var(--line); box-shadow:var(--shadow);}
  .btn-secondary:hover{border-color:var(--blue); color:var(--blue); transform:translateY(-2px);}
  .btn-whatsapp{background:#25D366; color:#fff;}
  .btn-whatsapp:hover{background:#1DA851; transform:translateY(-2px);}

  /* ================= NAV ================= */
  nav{
    position:fixed; top:0; left:0; right:0; z-index:100;
    background:rgba(255,255,255,0.82); backdrop-filter:blur(10px);
    border-bottom:1px solid transparent; transition:border-color .25s ease, box-shadow .25s ease;
  }
  nav.scrolled{border-color:var(--line); box-shadow:0 6px 24px rgba(11,37,69,0.06);}
  .nav-inner{display:flex; align-items:center; justify-content:space-between; padding:16px 24px; max-width:var(--maxw); margin:0 auto;}
  .logo{font-weight:700; font-size:18px; color:var(--navy); line-height:1.2;}
  .logo small{display:block; font-family:'Inter',sans-serif; font-weight:400; font-size:12px; color:var(--ink-mute);}
  .nav-links{display:flex; align-items:center; gap:34px;}
  .nav-links a{font-size:14.5px; font-weight:500; color:var(--ink); position:relative; padding:6px 0;}
  .nav-links a::after{
    content:""; position:absolute; left:0; bottom:0; width:0; height:2px; background:var(--blue);
    transition:width .2s ease;
  }
  .nav-links a:hover::after, .nav-links a.active::after{width:100%;}
  .nav-links a.active{color:var(--blue);}
  .nav-cta{white-space:nowrap;}
  .hamburger{display:none; flex-direction:column; gap:5px; background:none; border:none; cursor:pointer; padding:6px;}
  .hamburger span{width:24px; height:2px; background:var(--navy); border-radius:2px; transition:transform .2s ease, opacity .2s ease;}
  .mobile-menu{
    display:none; position:fixed; top:64px; left:0; right:0; bottom:0; background:#fff; z-index:99;
    padding:32px 24px; flex-direction:column; gap:6px; transform:translateY(-12px); opacity:0; pointer-events:none;
    transition:transform .25s ease, opacity .25s ease;
  }
  .mobile-menu.open{transform:translateY(0); opacity:1; pointer-events:auto;}
  .mobile-menu a{font-size:18px; font-weight:600; padding:16px 4px; border-bottom:1px solid var(--line);}
  @media (max-width:920px){
    .nav-links{display:none;}
    .hamburger{display:flex;}
    .mobile-menu{display:flex;}
  }

  /* ================= HERO ================= */
  .hero{padding-top:150px; padding-bottom:80px; background:linear-gradient(180deg, var(--blue-mist), #fff 70%); overflow:hidden;}
  .hero-grid{display:grid; grid-template-columns:1.05fr 0.95fr; gap:60px; align-items:center;}
  @media (max-width:940px){ .hero-grid{grid-template-columns:1fr;} }
  .hero h1{font-size:clamp(30px,4.6vw,50px); font-weight:700; line-height:1.18; letter-spacing:-0.01em; margin-bottom:22px;}
  .hero h1 .line2{color:var(--blue);}
  .hero .intro{font-size:16.5px; color:var(--ink-mute); line-height:1.7; max-width:560px; margin-bottom:26px;}
  .display-block{
    background:var(--white); border:1px solid var(--line); border-radius:16px; padding:16px 20px;
    display:inline-block; margin-bottom:26px; box-shadow:var(--shadow);
  }
  .display-name{font-weight:700; font-size:17px; color:var(--navy);}
  .display-title{font-size:13.5px; color:var(--ink-mute); margin-top:2px;}
  .pills{display:flex; flex-wrap:wrap; gap:10px; margin-bottom:26px;}
  .pill{
    font-size:13px; font-weight:500; padding:8px 14px; border-radius:999px;
    background:var(--blue-soft); color:var(--navy-2); border:1px solid rgba(46,139,255,0.18);
  }
  .trust-badges{display:flex; flex-wrap:wrap; gap:18px; margin-bottom:30px;}
  .trust-badges span{font-size:13.5px; font-weight:600; color:var(--navy); display:flex; align-items:center; gap:7px;}
  .trust-badges i{color:var(--blue);}
  .cta-row{display:flex; flex-wrap:wrap; gap:14px; margin-bottom:28px;}
  .contact-line{display:flex; flex-wrap:wrap; gap:24px; font-size:14.5px; color:var(--ink-mute);}
  .contact-line a{font-weight:600; color:var(--navy);}
  .contact-line i{color:var(--blue); margin-right:6px;}

  .hero-visual{position:relative; display:flex; justify-content:center;}
  .photo-frame{
    position:relative; width:100%; max-width:400px; aspect-ratio:4/5; border-radius:28px; overflow:hidden;
    background:linear-gradient(160deg, var(--navy), var(--navy-2)); box-shadow:var(--shadow-lg);
  }
  .photo-frame .avatar-fallback{
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center; flex-direction:column; color:#fff;
  }
  .avatar-fallback .initials{
    width:120px; height:120px; border-radius:50%; background:rgba(255,255,255,0.12);
    border:2px solid rgba(255,255,255,0.35); display:flex; align-items:center; justify-content:center;
    font-size:40px; font-weight:700; margin-bottom:18px;
  }
  .avatar-fallback p{font-size:13px; color:rgba(255,255,255,0.7); max-width:220px; text-align:center; line-height:1.5;}
  #heroPhoto{width:100%; height:100%; object-fit:cover; display:none;}
  .float-card{
    position:absolute; background:#fff; border-radius:14px; padding:12px 16px; box-shadow:var(--shadow-lg);
    display:flex; align-items:center; gap:10px; font-size:13.5px; font-weight:600; color:var(--navy);
    animation:float 4.5s ease-in-out infinite;
  }
  .fc1{top:6%; left:-6%;}
  .fc2{top:28%; right:-10%; animation-delay:.6s;}
  .fc3{bottom:24%; left:-10%; animation-delay:1.2s;}
  .fc4{bottom:4%; right:-4%; animation-delay:1.8s;}
  @keyframes float{ 0%,100%{transform:translateY(0);} 50%{transform:translateY(-10px);} }
  @media (max-width:600px){ .float-card{display:none;} }

  /* ================= PROBLEMS ================= */
  .problem-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-bottom:64px;}
  @media (max-width:880px){ .problem-grid{grid-template-columns:repeat(2,1fr);} }
  @media (max-width:560px){ .problem-grid{grid-template-columns:1fr;} }
  .problem-card{
    background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:26px;
    box-shadow:var(--shadow); transition:transform .2s ease, box-shadow .2s ease;
  }
  .problem-card:hover{transform:translateY(-6px); box-shadow:var(--shadow-lg);}
  .problem-card i{font-size:22px; color:var(--blue); margin-bottom:14px;}
  .problem-card h4{font-size:16px; font-weight:600;}

  .timeline{position:relative; display:flex; flex-wrap:wrap; justify-content:center; gap:0; margin-bottom:44px;}
  .timeline-step{
    display:flex; flex-direction:column; align-items:center; text-align:center; width:12.5%; min-width:110px; padding:0 6px;
  }
  .timeline-step .dot{
    width:44px; height:44px; border-radius:50%; background:var(--navy); color:#fff; display:flex; align-items:center;
    justify-content:center; font-weight:700; font-size:14px; margin-bottom:12px; position:relative; z-index:1;
  }
  .timeline-step:nth-child(6) .dot, .timeline-step:nth-child(7) .dot, .timeline-step:nth-child(8) .dot{background:var(--blue);}
  .timeline-step span.label{font-size:13px; font-weight:600; color:var(--navy);}
  .timeline-track{position:relative;}
  .timeline-track::before{
    content:""; position:absolute; top:22px; left:6%; right:6%; height:2px;
    background:repeating-linear-gradient(90deg, var(--line) 0 8px, transparent 8px 16px);
  }
  @media (max-width:900px){
    .timeline{flex-direction:column; align-items:flex-start; gap:16px;}
    .timeline-step{width:100%; flex-direction:row; text-align:left; gap:14px;}
    .timeline-step .dot{margin-bottom:0;}
    .timeline-track::before{display:none;}
  }
  .section-cta{text-align:center;}

  /* ================= WHY WORK WITH ME ================= */
  .feature-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:20px;}
  @media (max-width:920px){ .feature-grid{grid-template-columns:repeat(2,1fr);} }
  @media (max-width:560px){ .feature-grid{grid-template-columns:1fr;} }
  .feature-card{
    background:var(--blue-mist); border:1px solid var(--line); border-radius:var(--radius); padding:28px;
    transition:transform .2s ease, box-shadow .2s ease, background .2s ease;
  }
  .feature-card:hover{transform:translateY(-6px); background:#fff; box-shadow:var(--shadow-lg);}
  .feature-icon{
    width:52px; height:52px; border-radius:14px; background:var(--navy); color:#fff; display:flex; align-items:center;
    justify-content:center; font-size:20px; margin-bottom:18px;
  }
  .feature-card h4{font-size:16.5px; font-weight:600; margin-bottom:8px;}
  .feature-card p{font-size:14px; color:var(--ink-mute); line-height:1.6;}

  /* ================= PORTFOLIO ================= */
  .portfolio-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:20px; margin-bottom:48px;}
  @media (max-width:920px){ .portfolio-grid{grid-template-columns:repeat(2,1fr);} }
  @media (max-width:560px){ .portfolio-grid{grid-template-columns:1fr;} }
  .result-card{
    background:#fff; border:1px solid var(--line); border-radius:var(--radius); padding:26px; text-align:left;
    box-shadow:var(--shadow); position:relative; overflow:hidden;
  }
  .result-card::before{content:""; position:absolute; top:0; left:0; width:4px; height:100%; background:var(--blue);}
  .result-stat{font-size:26px; font-weight:800; color:var(--navy); margin-bottom:6px;}
  .result-client{font-size:14px; font-weight:600; color:var(--ink);}
  .result-tag{font-size:12.5px; color:var(--ink-mute); margin-top:4px;}
  .gallery-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-bottom:34px;}
  @media (max-width:700px){ .gallery-grid{grid-template-columns:1fr 1fr;} }
  .gallery-placeholder{
    aspect-ratio:4/3; border-radius:16px; background:var(--blue-soft); border:1.5px dashed rgba(46,139,255,0.4);
    display:flex; flex-direction:column; align-items:center; justify-content:center; color:var(--navy-2); gap:8px;
  }
  .gallery-placeholder i{font-size:22px; color:var(--blue);}
  .gallery-placeholder span{font-size:12.5px; font-weight:600;}
  .dash-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-bottom:30px;}
  @media (max-width:700px){ .dash-grid{grid-template-columns:1fr;} }
  .dash-card{background:var(--navy); color:#fff; border-radius:16px; padding:20px;}
  .dash-card h5{font-size:13px; text-transform:uppercase; letter-spacing:.05em; color:rgba(255,255,255,0.6); margin-bottom:10px;}
  .dash-bar{height:8px; border-radius:6px; background:rgba(255,255,255,0.15); overflow:hidden; margin-bottom:8px;}
  .dash-bar i{display:block; height:100%; background:var(--blue); border-radius:6px;}
  .badge-row{display:flex; flex-wrap:wrap; justify-content:center; gap:14px; margin:8px 0 20px;}
  .badge-row span{
    font-size:13px; font-weight:600; color:var(--navy); background:var(--blue-soft); padding:8px 16px; border-radius:999px;
    display:inline-flex; align-items:center; gap:6px;
  }
  .disclaimer{text-align:center; font-size:12.5px; color:var(--ink-mute); font-style:italic;}

  /* ================= CTA BANNER ================= */
  .cta-banner{
    background:linear-gradient(135deg, var(--navy), var(--navy-2)); color:#fff; border-radius:28px;
    padding:56px 32px; text-align:center; position:relative; overflow:hidden;
  }
  .cta-banner::before{
    content:""; position:absolute; width:340px; height:340px; border-radius:50%; top:-140px; right:-80px;
    background:radial-gradient(circle, var(--blue) 0%, transparent 70%); opacity:.35;
  }
  .cta-banner h2{position:relative; font-size:clamp(24px,3.4vw,34px); font-weight:700; margin-bottom:24px;}
  .cta-banner .cta-row{position:relative; justify-content:center;}
  .cta-banner .contact-line{position:relative; justify-content:center; margin-top:22px; color:rgba(255,255,255,0.75);}
  .cta-banner .contact-line a{color:#fff;}
  .cta-banner .contact-line i{color:var(--blue);}

  /* ================= PACKAGES ================= */
  .price-grid{display:grid; grid-template-columns:repeat(5,1fr); gap:18px; align-items:stretch;}
  @media (max-width:1100px){ .price-grid{grid-template-columns:repeat(3,1fr);} }
  @media (max-width:760px){ .price-grid{grid-template-columns:repeat(2,1fr);} }
  @media (max-width:520px){ .price-grid{grid-template-columns:1fr;} }
  .price-card{
    background:#fff; border:1px solid var(--line); border-radius:var(--radius); padding:26px; display:flex;
    flex-direction:column; position:relative; box-shadow:var(--shadow); transition:transform .2s ease, box-shadow .2s ease;
  }
  .price-card:hover{transform:translateY(-6px); box-shadow:var(--shadow-lg);}
  .price-card.recommended{
    border:2px solid var(--blue); box-shadow:0 0 0 6px rgba(46,139,255,0.08), var(--shadow-lg); transform:scale(1.03);
  }
  .price-badge{
    position:absolute; top:-13px; left:50%; transform:translateX(-50%); background:var(--blue); color:#fff;
    font-size:11.5px; font-weight:700; padding:6px 16px; border-radius:999px; letter-spacing:.03em; white-space:nowrap;
  }
  .price-name{font-size:14px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:var(--blue); margin-bottom:10px;}
  .price-amount{font-size:26px; font-weight:800; color:var(--navy); margin-bottom:2px;}
  .price-period{font-size:12.5px; color:var(--ink-mute); margin-bottom:6px;}
  .price-desc{font-size:12.5px; color:var(--ink-mute); margin-bottom:16px; line-height:1.5;}
  .price-list{margin-bottom:16px; flex-grow:1;}
  .price-list li{font-size:13px; padding:6px 0 6px 22px; position:relative; color:var(--ink);}
  .price-list li::before{content:"\f00c"; font-family:"Font Awesome 6 Free"; font-weight:900; position:absolute; left:0; color:var(--blue); font-size:11px; top:9px;}
  .price-outcome{font-size:12px; color:var(--ink-mute); background:var(--blue-mist); padding:10px 12px; border-radius:10px; margin-bottom:18px; line-height:1.5;}
  .price-cta{
    text-align:center; padding:12px; border-radius:10px; font-weight:700; font-size:13.5px; background:var(--navy); color:#fff;
    transition:background .18s ease;
  }
  .price-cta:hover{background:var(--blue);}
  .price-card.recommended .price-cta{background:var(--blue);}

  .notice-card{
    margin-top:44px; background:#FFF6E9; border:1px solid rgba(242,169,59,0.4); border-radius:16px; padding:22px 26px;
    display:flex; gap:16px; align-items:flex-start; max-width:760px; margin-left:auto; margin-right:auto;
  }
  .notice-card i{color:var(--gold); font-size:20px; margin-top:2px;}
  .notice-card p{font-size:14px; color:var(--ink); line-height:1.6;}
  .notice-card b{color:var(--navy);}

  .compare-wrap{margin-top:60px; overflow-x:auto;}
  table.compare{width:100%; border-collapse:collapse; min-width:760px;}
  table.compare th, table.compare td{
    padding:14px 16px; text-align:center; border-bottom:1px solid var(--line); font-size:13.5px;
  }
  table.compare th{background:var(--blue-mist); font-weight:700; color:var(--navy); font-size:13px;}
  table.compare td:first-child, table.compare th:first-child{text-align:left; font-weight:600; color:var(--ink);}
  table.compare th.rec, table.compare td.rec{background:var(--blue-soft);}
  table.compare i.yes{color:var(--blue);}
  table.compare i.no{color:#c7cede;}
  @media (max-width:760px){
    .compare-wrap{
      display:flex; gap:14px; overflow-x:auto; scroll-snap-type:x mandatory; padding-bottom:10px;
    }
    table.compare{display:none;}
    .compare-card{
      min-width:220px; scroll-snap-align:start; background:#fff; border:1px solid var(--line); border-radius:16px; padding:18px;
      flex-shrink:0;
    }
    .compare-card.rec{border-color:var(--blue); box-shadow:0 0 0 4px rgba(46,139,255,0.08);}
    .compare-card h5{font-size:13px; text-transform:uppercase; color:var(--blue); margin-bottom:10px;}
    .compare-card ul li{font-size:13px; padding:6px 0; display:flex; justify-content:space-between; border-bottom:1px dashed var(--line);}
  }

  /* ================= CONTACT ================= */
  .contact-grid{display:grid; grid-template-columns:1.3fr 0.9fr; gap:40px; align-items:flex-start;}
  @media (max-width:900px){ .contact-grid{grid-template-columns:1fr;} }
  .form-card{background:#fff; border:1px solid var(--line); border-radius:var(--radius); padding:32px; box-shadow:var(--shadow);}
  .form-grid{display:grid; grid-template-columns:1fr 1fr; gap:16px;}
  @media (max-width:560px){ .form-grid{grid-template-columns:1fr;} }
  .field{display:flex; flex-direction:column; gap:6px; margin-bottom:16px;}
  .field.full{grid-column:1 / -1;}
  .field label{font-size:13px; font-weight:600; color:var(--navy);}
  .field input, .field select, .field textarea{
    border:1.5px solid var(--line); border-radius:10px; padding:12px 14px; font-family:'Inter',sans-serif;
    font-size:14px; color:var(--ink); background:var(--blue-mist); transition:border-color .18s ease, background .18s ease;
  }
  .field input:focus, .field select:focus, .field textarea:focus{
    outline:none; border-color:var(--blue); background:#fff;
  }
  .field textarea{resize:vertical; min-height:90px;}
  .field .err{font-size:12px; color:#D64545; min-height:14px;}
  .submit-btn{width:100%; justify-content:center; font-size:15.5px; padding:16px;}
  .form-msg{
    display:none; margin-top:16px; padding:14px 16px; border-radius:12px; background:#E9F9EF; color:#1E7A43;
    font-size:14px; font-weight:600; align-items:center; gap:10px;
  }
  .form-msg.show{display:flex;}

  .contact-cards{display:flex; flex-direction:column; gap:16px;}
  .contact-card{
    background:#fff; border:1px solid var(--line); border-radius:16px; padding:20px; display:flex; gap:14px;
    align-items:flex-start; box-shadow:var(--shadow);
  }
  .contact-card i{
    width:44px; height:44px; border-radius:12px; background:var(--blue-soft); color:var(--blue); display:flex;
    align-items:center; justify-content:center; font-size:17px; flex-shrink:0;
  }
  .contact-card h5{font-size:14px; font-weight:700; margin-bottom:4px;}
