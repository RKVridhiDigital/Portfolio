<script>
  // ---- Sticky nav shadow ----
  const nav = document.getElementById('mainNav');
  window.addEventListener('scroll', ()=>{
    nav.classList.toggle('scrolled', window.scrollY > 10);
  });

  // ---- Mobile menu ----
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobileMenu');
  hamburger.addEventListener('click', ()=>{
    mobileMenu.classList.toggle('open');
  });
  mobileMenu.querySelectorAll('a').forEach(a=>{
    a.addEventListener('click', ()=> mobileMenu.classList.remove('open'));
  });

  // ---- Active menu highlight on scroll ----
  const sections = ['about','portfolio','packages','contact'].map(id=>document.getElementById(id));
  const navLinkEls = document.querySelectorAll('.nav-links .nav-link');
  const highlightNav = ()=>{
    let current = sections[0].id;
    sections.forEach(sec=>{
      const rect = sec.getBoundingClientRect();
      if(rect.top <= 140) current = sec.id;
    });
    navLinkEls.forEach(link=>{
      link.classList.toggle('active', link.getAttribute('href') === '#' + current);
    });
  };
  window.addEventListener('scroll', highlightNav);
  highlightNav();

  // ---- Scroll reveal ----
  const revealEls = document.querySelectorAll('[data-reveal]');
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, {threshold:0.12});
  revealEls.forEach(el=>io.observe(el));

  // ---- Hero / final photo fallback ----
  // To use a real photo: set the src attribute of #heroPhoto and #finalPhoto to your image path,
  // e.g. src="rakesh-kumar.jpg", then this script will swap the placeholder for the real image.
  function tryLoadPhoto(imgId, fallbackId){
    const img = document.getElementById(imgId);
    if(img && img.getAttribute('src')){
      img.onload = ()=>{
        img.style.display = 'block';
        const fb = document.getElementById(fallbackId);
        if(fb) fb.style.display = 'none';
      };
    }
  }
  tryLoadPhoto('heroPhoto','heroFallback');

  // ---- Contact form validation + fake submit ----
  const form = document.getElementById('leadForm');
  const formMsg = document.getElementById('formMsg');
  form.addEventListener('submit', function(e){
    e.preventDefault();
    let valid = true;
    const requiredFields = ['fullName','businessName','whatsapp','email'];
    requiredFields.forEach(id=>{
      const input = document.getElementById(id);
      const errEl = document.querySelector(`[data-err-for="${id}"]`);
      errEl.textContent = '';
      if(!input.value.trim()){
        errEl.textContent = 'This field is required.';
        valid = false;
      } else if(id === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value)){
        errEl.textContent = 'Enter a valid email address.';
        valid = false;
      } else if(id === 'whatsapp' && input.value.replace(/\D/g,'').length < 10){
        errEl.textContent = 'Enter a valid WhatsApp number.';
        valid = false;
      }
    });
    if(!valid) return;

    // NOTE: this demo shows a success message only. Connect this form to your
    // backend, Google Sheets, or a form service (e.g. Formspree) to actually receive submissions.
    formMsg.classList.add('show');
    form.reset();
    formMsg.scrollIntoView({behavior:'smooth', block:'center'});
  });
</script>

